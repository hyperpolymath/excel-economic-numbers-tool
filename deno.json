{
  "name": "@hyperpolymath/economic-toolkit",
  "version": "2.1.0",
  "exports": "./src/rescript/mod.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-env src/server.ts",
    "start": "deno run --allow-net --allow-read --allow-env src/server.ts",
    "rescript:build": "deno run -A --node-modules-dir=auto npm:rescript@^12.0.0 build",
    "rescript:clean": "deno run -A --node-modules-dir=auto npm:rescript@^12.0.0 clean",
    "build": "deno task rescript:build && deno bundle src/mod.ts dist/economic-toolkit.js",
    "build:excel": "just build-excel",
    "build:libre": "just build-libre",
    "test": "deno test --allow-net --allow-read --allow-env",
    "test:watch": "deno test --watch --allow-net --allow-read --allow-env",
    "coverage": "deno test --coverage=coverage --allow-net --allow-read --allow-env",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "check": "deno check src/**/*.ts"
  },
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "lib": ["deno.window", "dom", "dom.iterable", "esnext"]
  },
  "lint": {
    "files": {
      "include": ["src/"],
      "exclude": ["src/rescript/*.res.js", "node_modules/", "dist/"]
    },
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "files": {
      "include": ["src/", "tests/"],
      "exclude": ["src/rescript/*.res.js", "node_modules/", "dist/"]
    },
    "options": {
      "useTabs": false,
      "lineWidth": 100,
      "indentWidth": 2,
      "semiColons": true,
      "singleQuote": false,
      "proseWrap": "preserve"
    }
  },
  "test": {
    "files": {
      "include": ["tests/"],
      "exclude": ["tests/python/", "tests/R/"]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/http": "jsr:@std/http@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    "rescript": "npm:rescript@^12.0.0",
    "@rescript/core": "npm:@rescript/core@^1.6.0",
    "@microsoft/office-js": "npm:@microsoft/office-js@^1.1.0"
  },
  "nodeModulesDir": "auto"
}
