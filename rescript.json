{
  "name": "economic-toolkit",
  "version": "2.1.0",
  "sources": [
    {
      "dir": "src/rescript",
      "subdirs": true
    }
  ],
  "package-specs": [
    {
      "module": "es6",
      "in-source": true
    }
  ],
  "suffix": ".res.js",
  "bs-dependencies": ["@rescript/core"],
  "pinned-dependencies": [],
  "warnings": {
    "error": "+101+8"
  },
  "bsc-flags": ["-open RescriptCore"],
  "jsx": {
    "version": 4,
    "mode": "automatic"
  },
  "gentypeconfig": {
    "language": "typescript",
    "module": "es6",
    "exportInterfaces": true
  }
}
