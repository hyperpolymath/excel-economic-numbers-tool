{
  "$schema": "https://gossamer.dev/schemas/config/v1",
  "productName": "Economic Toolkit",
  "version": "2.2.0",
  "identifier": "org.hyperpolymath.economictoolkit",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../web && deno task dev",
    "beforeBuildCommand": "cd ../web && deno task build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Economic Toolkit",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "maxWidth": null,
        "maxHeight": null,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false,
        "visible": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8080 https://api.economictoolkit.org",
      "capabilities": [
        "filesystem",
        "network",
        "shell",
        "clipboard"
      ],
      "capabilityTokens": {
        "enabled": false,
        "issuer": "gossamer-runtime",
        "ttl": 3600
      },
      "sandbox": {
        "enabled": true,
        "allowExec": false,
        "allowNetwork": true,
        "allowFilesystem": true
      }
    },
    "ipc": {
      "protocol": "json",
      "bridgeInjection": true,
      "maxMessageSize": 16777216,
      "timeout": 30000
    },
    "tray": {
      "enabled": false,
      "icon": null,
      "tooltip": null,
      "menuOnLeftClick": true
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "Copyright (c) 2024-2026 Jonathan D.A. Jewell (hyperpolymath)",
    "license": "PMPL-1.0-or-later",
    "shortDescription": "Economic data analysis toolkit",
    "longDescription": "Cross-platform economic data analysis with 10+ data sources",
    "linux": {
      "desktopEntry": true,
      "category": "Finance",
      "section": "utils",
      "depends": [],
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macos": {
      "bundleIdentifier": "org.hyperpolymath.economictoolkit",
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "entitlements": null,
      "signingIdentity": null,
      "notarization": {
        "enabled": false,
        "teamId": null
      }
    },
    "windows": {
      "webview2": "embed",
      "certificateThumbprint": null,
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": null
      }
    },
    "mobile": {
      "ios": {
        "minimumVersion": "14.0",
        "deviceFamily": [
          "iphone",
          "ipad"
        ],
        "capabilities": [],
        "frameworks": [],
        "entitlements": {}
      },
      "android": {
        "minimumSdk": 24,
        "targetSdk": 34,
        "permissions": [
          "android.permission.INTERNET"
        ],
        "features": []
      }
    }
  },
  "ephapax": {
    "modules": [],
    "region": "app",
    "linearVerification": true,
    "regionBoundary": "strict",
    "preload": []
  }
}
