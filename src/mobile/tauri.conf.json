{
  "package": {
    "productName": "Economic Toolkit",
    "version": "2.2.0"
  },
  "build": {
    "distDir": "../web/dist",
    "devPath": "http://localhost:5173",
    "beforeDevCommand": "cd ../web && npm run dev",
    "beforeBuildCommand": "cd ../web && npm run build"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "http": {
        "all": true,
        "request": true,
        "scope": ["http://localhost:8080/**", "https://api.economictoolkit.org/**"]
      },
      "fs": {
        "readFile": true,
        "writeFile": true,
        "scope": ["$APPDATA/economic-toolkit/**"]
      },
      "shell": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "identifier": "org.hyperpolymath.economictoolkit",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "Finance",
      "copyright": "2024-2026 Hyperpolymath Contributors",
      "shortDescription": "Economic data analysis toolkit",
      "longDescription": "Cross-platform economic data analysis with 10+ data sources",
      "iOS": {
        "minimumSystemVersion": "14.0"
      },
      "android": {
        "minSdkVersion": 24
      }
    },
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8080 https://api.economictoolkit.org"
    },
    "windows": [
      {
        "title": "Economic Toolkit",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
