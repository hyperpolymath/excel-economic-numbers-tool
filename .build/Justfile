# Excel-Economic-Numbers-Tool - AffineScript Development Tasks
set shell := ["bash", "-uc"]
set dotenv-load := true

project := "Excel-Economic-Numbers-Tool"

# Show all recipes
default:
    @just --list --unsorted

# Build
build:
    npx affinescript build

# Build clean
build-clean:
    npx affinescript build -clean-world

# Watch mode
watch:
    npx affinescript build -w

# Format code
fmt:
    npx affinescript format -all

# Clean
clean:
    npx affinescript clean

# Install dependencies
install:
    npm install

# Run tests
test:
    npm test

# All checks before commit
pre-commit: build test
    @echo "All checks passed!"

secret-scan-trufflehog:
    @command -v trufflehog >/dev/null && trufflehog filesystem . --only-verified || true
